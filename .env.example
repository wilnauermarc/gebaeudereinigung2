# Kopieren nach .env und anpassen
# Domain, die auf den Server zeigt (A-Eintrag), zum Beispiel app.putzbetrieb.app (die Webseite liegt getrennt auf der Hauptdomain)
DOMAIN=app.putzbetrieb.app
# Einrichtungscode für den ersten Aufruf. Erzeugen mit: openssl rand -hex 16
SETUP_TOKEN=
# Abo-Steuerung (nur für den Betreiber, bei Eigenbetrieb leer lassen)
# Paket: einfach | standard | alles
LICENSE_PLAN=
# Testphase bis (JJJJ-MM-TT): alle Bausteine, danach nur noch Lesen
LICENSE_TRIAL_UNTIL=
# Bezahlt bis (JJJJ-MM-TT): Bausteine des Pakets
LICENSE_PAID_UNTIL=
# Testanmeldung (mehrere Betriebe in einer Installation): TENANTS=1 schaltet /start ein
TENANTS=
# höchste Zahl gleichzeitiger Testbetriebe (Standard 200)
MAX_TENANTS=
# E-Mail-Versand für Bestätigungslinks und Erinnerungen, zum Beispiel smtps://benutzer:passwort@mail.beispiel.de:465
SMTP_URL=
MAIL_FROM=Putzbetrieb <noreply@putzbetrieb.app>
