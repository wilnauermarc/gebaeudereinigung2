# Kopieren nach sites/demo.caddy und die Adresse anpassen. Voraussetzung: A-Eintrag für die Adresse auf den Server.
demo.putzbetrieb.app {
	encode zstd gzip
	reverse_proxy demo:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
	}
}
