{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	# Nur HSTS setzen: Referrer-Policy, nosniff und weitere Header kommen schon von der App (sonst doppelt)
	header {
		Strict-Transport-Security "max-age=31536000"
	}
}

# www.<Domain> leitet auf die Hauptadresse weiter. Der A-Eintrag für www muss auf den Server zeigen.
# Bei einer Subdomain wie app.beispiel.de diesen Block entfernen (www.app.… gibt es nicht).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
